# BranCodeX Next.js - local environment
# Copy to .env.local and fill in values. Never commit .env.local to version control.

# URL of the BranCodeX Express backend.
# Development: http://localhost:4000
# Production:  https://your-backend.railway.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Groq API key for the chat assistant (server-side only, never expose to the browser).
GROQ_API_KEY=
